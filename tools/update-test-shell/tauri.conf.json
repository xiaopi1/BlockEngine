{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "方块引擎",
	"version": "1.7.1",
	"identifier": "cn.blockengine.launcher",
	"mainBinaryName": "BlockEngine",
	"build": {
		"frontendDist": "frontend"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "方块引擎更新验证",
				"width": 720,
				"height": 450,
				"resizable": false,
				"center": true
			}
		],
		"security": {
			"capabilities": ["core", "updater"]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["../../apps/app/icons/icon.ico"],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxQzNFQTk5MEE5QUIwMkIKUldRcnNKb0ttZXJEUVRMNEp4K1NUTURoallBdmpiSnQ5UGQxNENZcjFNRjZRcmJSZ09HWHd3V28K",
			"endpoints": ["https://san2.top/blockengine/latest.php"],
			"windows": {
				"installMode": "quiet"
			}
		}
	}
}

